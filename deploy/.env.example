# Copier en deploy/.env (ignoré par Git) et remplacer chaque valeur.
# Générer des secrets : openssl rand -base64 48
GESTSTOCK_DB_PASSWORD=change-me
# Clé de signature des jetons : 32 octets minimum.
GESTSTOCK_JWT_SECRET=change-me-with-at-least-32-random-bytes
# Administrateur créé au premier démarrage s'il n'en existe aucun (12 caractères minimum).
GESTSTOCK_ADMIN_USERNAME=admin
GESTSTOCK_ADMIN_PASSWORD=change-me-12-chars-min
